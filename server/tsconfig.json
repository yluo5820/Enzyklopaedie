{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS", // Node.js typically uses CommonJS
    "rootDir": "./src",
    "outDir": "./dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true, // <--- Ensure this is true
    "skipLibCheck": true,
    "declaration": true, // Generate .d.ts files for better type checking
    "sourceMap": true,
    "resolveJsonModule": true,

    /* Path Aliases (Optional) */
    "paths": {
      "@config/*": ["./src/config/*"],
      "@controllers/*": ["./src/controllers/*"],
      "@db/*": ["./src/db/*"],
      "@routes/*": ["./src/routes/*"],
      "@types/*": ["./src/types/*"],
      "@utils/*": ["./src/utils/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules"]
}